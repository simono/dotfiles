# git configuration file.
#
# Location: ~/.config/git/config
#
# Simon Olofsson <simon@olofsson.de>
#

[advice]
	skippedCherryPicks = false
[branch]
	autoSetupRebase = always
	sort = -committerdate
[commit]
	gpgSign = true
	verbose = true
[core]
	pager = delta
[delta]
	# Commits under git log --graph, and the ▸ line of the [pretty] formats, so
	# the TUI can open them.
	commit-regex = "^[*|/\\\\ ]*(▸|commit )"
	commit-decoration-style = blue ol
	hyperlinks = true
	line-numbers = true
	# n and N between files, outside the TUI
	navigate = true
	# Side by side only for hunks with both sides, and only from 140 columns.
	side-by-side = hunk,140
	# TUI
	log-args = --stat
	log-args = --pretty=commit-format
	# Deleted files as a header only, as on GitHub.
	show-args = -D
	show-args = --pretty=commit-format-full
	file-header = stat
	start-folded = true
	bind = root.show-or-unfold enter
	bind = root.toggle-all-sections alt+enter
	# Default is alt+enter, taken by toggle-all-sections above.
	bind = root.show-in-alt-editor ctrl+o
	bind = root.fold-or-back h
	bind = root.help-menu ?
	# Default is alt+j / alt+k: option types accented letters on macOS.
	bind = root.move-next-section ]
	bind = root.move-prev-section [
	# Default is enter: o opens the file, hunk or line in the editor, as in vim.
	bind = root.show o
	# Default is o, taken by show above.
	bind = root.show-on-github g+h
	# Keys set here replace the defaults: S and L again.
	feature-key = side-by-side S
	feature-key = line-numbers L
	feature-key = with-deleted D
	feature-key = ignore-whitespace W
	view = ignore-whitespace {command} -w
	# show-args hides deleted files: open the commit again with them.
	view = with-deleted git show --pretty=commit-format-full {commit}
[diff]
	renames = copies
	colorMoved = default
	algorithm = histogram
	wsErrorHighlight = all
[fetch]
	prune = true
[gpg]
	format = ssh
[help]
	autoCorrect = prompt
[interactive]
	diffFilter = delta --color-only
[log]
	follow = true
	abbrevCommit = true
	# auto drops them under the delta TUI pager.
	decorate = short
	date = auto:relative
[merge]
	conflictStyle = zdiff3
[pager]
	diff = delta --tui
	log = delta --tui
	show = delta --tui
[pretty]
	commit-format = tformat:%n%n▸ %h %C(blue)%an %C(blue)%ar%C(auto)%d%C(reset)%n%n    %C(green)%s%C(auto)
	commit-format-full = tformat:%n%n▸ %h %C(blue)%an %C(blue)%ar%C(auto)%d%C(reset)%n%n%w(0,4,4)%C(green)%s%C(reset)%n%+b
[pull]
	rebase = true
[push]
	autoSetupRemote = true
	recurseSubmodules = no
[rebase]
	autoSquash = true
	autoStash = true
	# Moves a backup branch too: snapshot with a tag, or --no-update-refs.
	updateRefs = true
[rerere]
	enabled = true
[submodule]
	recurse = true
[sequence]
	# Without a terminal (agents, scripts) the TUI cannot start: keep the list as is.
	editor = "f() { if [ -t 1 ]; then delta --tui sequence-editor \"$@\"; fi; }; f"
[status]
	showStash = true
[include]
	path = config.local
	path = config.themes
