# git configuration file.
#
# Location: ~/.config/git/config
#
# Simon Olofsson <simon@olofsson.de>
#

[advice]
	skippedCherryPicks = false
[branch]
	autoSetupRebase = always
[commit]
	gpgSign = true
	verbose = true
[core]
	pager = delta
[delta]
	hyperlinks = true
	line-numbers = true
	# use n and N to move between diff sections
	navigate = true
	# Side by side only for hunks with both sides, and only from 140 columns.
	side-by-side = hunk,140
[diff]
	renames = copies
	colorMoved = default
	algorithm = histogram
	wsErrorHighlight = all
[fetch]
	prune = true
[gpg]
	format = ssh
[help]
	autoCorrect = prompt
[interactive]
	diffFilter = delta --color-only
[log]
	follow = true
	abbrevCommit = true
	date = auto:relative
[merge]
	conflictStyle = zdiff3
[pull]
	rebase = true
[push]
	autoSetupRemote = true
	recurseSubmodules = no
[rebase]
	autoSquash = true
	autoStash = true
[rerere]
	enabled = true
[submodule]
	recurse = true
[status]
	showStash = true
[include]
	path = config.local
	path = config.themes
